{
  "metadata": {
    "description": "Published by Appeal Desk from https://www.ecfr.gov/current/title-45/subtitle-A/subchapter-B/part-147/section-147.136. A rule table plus a rule explainer for Health plan appeal rules (ACA, non-grandfathered plans). The rule owner or a state consumer assistance program can publish a replacement and Appeal Desk will load it by changing one line in peers.config.json.",
    "sample_queries": [
      "What is the appeal deadline for a medical necessity denial?"
    ],
    "appeal_rules": {
      "rule_id": "aca_appeal_rules",
      "title": "Health plan appeal rules (ACA, non-grandfathered plans)",
      "cfr_cite": "45 CFR 147.136",
      "ecfr_url": "https://www.ecfr.gov/current/title-45/subtitle-A/subchapter-B/part-147/section-147.136",
      "internal_appeal_filing_days": 180,
      "internal_appeal_filing_cite": "29 CFR 2560.503-1(h)(3)(i), required by 45 CFR 147.136(b)(2)(i)",
      "internal_appeal_filing_url": "https://www.ecfr.gov/current/title-29/subtitle-B/chapter-XXV/part-2560/section-2560.503-1",
      "decision_days_preservice": 30,
      "decision_days_postservice": 60,
      "decision_days_cite": "29 CFR 2560.503-1(i)(2)(ii)-(iii), required by 45 CFR 147.136(b)(2)(i)",
      "urgent_decision_hours": 72,
      "urgent_decision_cite": "45 CFR 147.136(b)(2)(ii)(B)",
      "external_review_request_months": 4,
      "external_review_cite": "45 CFR 147.136(d)(2)(i)",
      "external_review_path": "Insured plans follow the State external review process when the State has a qualifying one, and the Federal process otherwise. A State process must allow at least four months to file. Federal review: preliminary review in 5 business days, decision within 45 days, 72 hours when expedited.",
      "after_appeal_note": "If the plan does not follow the internal process, you are deemed to have exhausted it and may go straight to external review.",
      "after_appeal_cite": "45 CFR 147.136(b)(2)(ii)(F)(1)",
      "documents_you_can_request": [
        {
          "id": "claim_file",
          "label": "The full claim file",
          "cite": "45 CFR 147.136(b)(2)(ii)(C)",
          "ecfr_url": "https://www.ecfr.gov/current/title-45/subtitle-A/subchapter-B/part-147/section-147.136"
        },
        {
          "id": "new_evidence",
          "label": "Any new or additional evidence the plan considered, free of charge",
          "cite": "45 CFR 147.136(b)(2)(ii)(C)(1)",
          "ecfr_url": "https://www.ecfr.gov/current/title-45/subtitle-A/subchapter-B/part-147/section-147.136"
        },
        {
          "id": "codes",
          "label": "The diagnosis code, the treatment code, and what each one means",
          "cite": "45 CFR 147.136(b)(2)(ii)(E)",
          "ecfr_url": "https://www.ecfr.gov/current/title-45/subtitle-A/subchapter-B/part-147/section-147.136"
        },
        {
          "id": "relevant_docs",
          "label": "Documents relevant to your claim, upon request and free of charge",
          "cite": "29 CFR 2560.503-1(h)(2)(iii)",
          "ecfr_url": "https://www.ecfr.gov/current/title-29/subtitle-B/chapter-XXV/part-2560/section-2560.503-1"
        }
      ],
      "other_cites": {
        "continued_coverage": {
          "text": "Coverage continues while the appeal is decided.",
          "cite": "45 CFR 147.136(b)(2)(iii)"
        },
        "full_review": {
          "text": "The appeal review does not defer to the first denial.",
          "cite": "29 CFR 2560.503-1(h)(3)(ii)"
        },
        "urgent_path": {
          "text": "An urgent care claim must be decided as soon as possible and no later than 72 hours after receipt.",
          "cite": "45 CFR 147.136(b)(2)(ii)(B)"
        }
      },
      "verified": true,
      "recheck": [
        "Sub-paragraph numbers of 147.136(b)(2)(ii)(E) were read from a summarised eCFR page; confirm the anchor before relying on the cite.",
        "The 180-day figure is confirmed in 29 CFR 2560.503-1(h)(3)(i); 147.136 points to it."
      ]
